[Unit]
Description=GOST v3 Simple Tunnel Daemon
After=network.target network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStartPre=/usr/local/bin/ip_manager.sh restore
ExecStart=/usr/local/bin/gost -C /etc/gost/gost.yaml
Restart=always
RestartSec=3s
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
